# Discord
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=

# Endpoint monitoring: comma-separated "name=url" pairs, polled each cycle for
# down/recovery alerts (empty = disabled)
MONITORED_ENDPOINTS=
MONITOR_INTERVAL_SECONDS=60
# Scheduled digests to DISCORD_STATUS_CHANNEL_ID (unset that id to disable both).
REPORT_HOUR_UTC=5
WEEKLY_REPORT_WEEKDAY=0
DIGEST_LOOKBACK_DAYS=7

# Self-hosted / OpenAI-compatible LLM (e.g. Ollama, vLLM, llama.cpp server)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral
LLM_API_KEY=sk-optional

# Monitoring / logging sources
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
PROMETHEUS_TOKEN=
LOKI_TOKEN=


# Docker container discovery
# DOCKER_HOST defaults to unix:///var/run/docker.sock; set tcp://host:2375 for a
# remote daemon. Leave unset (or empty) for the normal local socket.
#DOCKER_HOST=
# Poll containers each cycle and alert when one stops. Scope = containers whose
# name contains DOCKER_NAME_FILTER (empty filter = every container) plus anything
# on the /watch list.
DOCKER_MONITOR=false
# Only track containers whose name contains this substring (empty = all).
DOCKER_NAME_FILTER=

# Agentic investigation loop
MAX_TOOL_STEPS=10
# Context budget per model turn; older messages in a channel thread are trimmed past it.
MAX_CONTEXT_TOKENS=12000
LOKI_MAX_LIMIT=500
RANGE_MAX_HOURS=6

# Storage
DATABASE_URL=sqlite:///data/agent.db

# LangSmith / LangChain tracing (off by default: adds upload + retry stalls per
# LLM call; only enable if you actively use the LangSmith dashboard).
LANGSMITH_TRACING=false
