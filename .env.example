# Discord
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_REPORTS_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_INCIDENT_CHANNEL_ID=
DISCORD_TEST_SCENARIOS_CHANNEL_ID=

# Endpoint monitoring: comma-separated "name=url" pairs, polled each cycle for
# down/recovery alerts (empty = disabled), e.g.
#   MONITORED_ENDPOINTS=prometheus=http://localhost:9090/-/healthy,loki=http://localhost:3100/ready
MONITORED_ENDPOINTS=
MONITOR_INTERVAL_SECONDS=60
# PromQL alert rules: comma-separated "name=promql", evaluated each cycle. A rule
# fires when its query returns any series. Only the first "=" splits the name, so
# an expression containing "==" is fine, e.g.
#   PROMETHEUS_ALERT_RULES=target_down=up == 0
PROMETHEUS_ALERT_RULES=
# Scheduled digests to DISCORD_REPORTS_CHANNEL_ID (a forum channel works —
# each digest becomes its own thread) — unset that id to disable both.
# UTC hour — 5 is 08:00 EAT (UTC+3). 0 = Monday.
REPORT_HOUR_UTC=5
WEEKLY_REPORT_WEEKDAY=0
DIGEST_LOOKBACK_DAYS=7
# Periodic snapshot to DISCORD_STATUS_CHANNEL_ID; first one fires on startup.
STATUS_INTERVAL_HOURS=2

# LLM provider: "openai" (self-hosted / OpenAI-compatible, e.g. Ollama, vLLM,
# llama.cpp server) or "google" (Gemini/Gemma)
LLM_PROVIDER=google
# Cheaper model for SummarizationMiddleware; blank reuses LLM_MODEL.
LLM_SUMMARIZER_MODEL=
LLM_MODEL=gemma-4-31b-it
# openai provider only
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=sk-optional
# google provider only
GEMINI_API_KEY=

# Monitoring / logging sources
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
PROMETHEUS_TOKEN=
LOKI_TOKEN=


# Docker container discovery
# DOCKER_HOST defaults to unix:///var/run/docker.sock; set tcp://host:2375 for a
# remote daemon. Leave unset (or empty) for the normal local socket.
#DOCKER_HOST=
# Poll containers each cycle and alert when one stops. Scope = containers whose
# name contains DOCKER_NAME_FILTER (empty filter = every container) plus anything
# on the /watch list.
DOCKER_MONITOR=false
# Only track containers whose name contains this substring (empty = all).
DOCKER_NAME_FILTER=

# Agentic investigation loop
MAX_TOOL_STEPS=20
# Context budget per model turn; older messages in a channel thread are trimmed past it.
MAX_CONTEXT_TOKENS=12000
LOKI_MAX_LIMIT=500
RANGE_MAX_HOURS=6

# HTTP API (`agent api`). Leave API_KEY blank to leave the API unauthenticated.
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Storage
DATABASE_URL=sqlite:///data/agent.db

# LangSmith / LangChain tracing (off by default: adds upload + retry stalls per
# LLM call; only enable if you actively use the LangSmith dashboard).
LANGSMITH_TRACING=false
