# Discord
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_INCIDENT_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_TEST_SCENARIOS_CHANNEL_ID=
# Optional: user ID to receive DMs when incidents are created.
DISCORD_DM_USER_ID=

# Endpoint monitoring (comma-separated "name=url" pairs; empty = disabled)
MONITORED_ENDPOINTS=
MONITOR_INTERVAL_SECONDS=60

# Self-hosted / OpenAI-compatible LLM (e.g. Ollama, vLLM, llama.cpp server)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral
LLM_API_KEY=sk-optional

# API server
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

# Monitoring / logging sources
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
PROMETHEUS_TOKEN=
LOKI_TOKEN=

# PromQL alert rules the monitor evaluates each cycle.
# Format: "name=<PromQL>" pairs, comma-separated. A rule fires when the query returns >=1 series.
# Example: PROMETHEUS_ALERT_RULES=target_down=up == 0,high_load=node_load1 > 4
PROMETHEUS_ALERT_RULES=

# Docker container discovery
# DOCKER_HOST defaults to unix:///var/run/docker.sock; set tcp://host:2375 for a remote daemon.
DOCKER_HOST=
# Poll running containers each cycle and alert when one stops (new containers auto-discovered).
DOCKER_MONITOR=false
# Only watch containers whose name contains this substring (empty = all).
DOCKER_NAME_FILTER=

# Agentic investigation loop
MAX_TOOL_STEPS=6
LOKI_MAX_LIMIT=500
RANGE_MAX_HOURS=6

# Storage
DATABASE_URL=sqlite:///data/agent.db
