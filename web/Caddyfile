# Caddy config for the Marconi ops web. Drop into /etc/caddy/Caddyfile on the
# host (Caddy runs as a systemd service). The SPA bundle is published to the
# web-dist directory by `docker compose up web`.
:8088 {
	root * /srv/marconi/web
	encode zstd gzip

	# API reverse-proxy — must be a named handle so the SPA fallback
	# (try_files) does not intercept /api/* paths.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8123
	}

	# Everything else is the SPA: serve static files, fall back to index.html.
	handle {
		file_server
		try_files {path} /index.html
	}
}
