# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local environment and runtime data
.env
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/logs/
data/log_cursors.json
.pytest_cache/

# Env backups (secrets)
.env*

# Aggregate extracts (large, local-only)
data/aggregate/

# Combined eval dataset built from the aggregate extracts (large, local-only,
# regenerate with scripts/build_eval_dataset.sh)
data/eval/

# Per-run transcripts dumped by agent.eval_transcript.run_eval_loop
eval/logs/
eval/results/
